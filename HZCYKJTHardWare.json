{
  "delphi_server": {
    "host": "127.0.0.1",
    "port": 8089,
    "auto_start": true,
    "executable": "HZCYKJTHardWare.Proxy.exe",
    "start_wait_ms": 10000,
    "ping_interval_ms": 300
  },
  "terminal_callback_server": {
    "listen_host": "0.0.0.0",
    "public_host": "",
    "port": 8088,
    "path": "/terminal-callback"
  },
  "terminal": {
    "mode": "auto_subnet",
    "scheme": "http",
    "port": 9098,
    "check_on_init": false,
    "default_index": 2,
    "preferred_subnet_prefix": "192.168.20",
    "fixed_terminals": [
      {
        "index": 1,
        "name": "左通道",
        "base_url": ""
      },
      {
        "index": 2,
        "name": "右通道",
        "base_url": ""
      }
    ],
    "auto_subnet_devices": [
      {
        "index": 1,
        "name": "左通道",
        "host_suffix": 30
      },
      {
        "index": 2,
        "name": "右通道",
        "host_suffix": 31
      }
    ]
  },
  "callback_server": {
    "host": "",
    "auto_bind_lan_ip": true,
    "listen_any": false,
    "port": 39091,
    "base_path": "/HZCYKJTHardWare/callback"
  },
  "timeout": {
    "http_connect_ms": 3000,
    "http_request_ms": 15000,
    "face_capture_ms": 5000,
    "fingerprint_capture_ms": 5000,
    "ocr_ms": 10000,
    "authorize_ms": 60000
  },
  "save": {
    "default_root": ".\\captures",
    "camera_default_path": ".\\captures\\camera.jpg",
    "fingerprint_default_path": ".\\captures\\fingerprint.jpg",
    "create_date_folder": false,
    "create_request_folder": false
  },
  "preview": {
    "renderer": "libvlc",
    "auto_reconnect": true,
    "check_hwnd_interval_ms": 500,
    "stop_preview_on_end_process": false,
    "rtsp_network_caching_ms": 50,
    "rtsp_live_caching_ms": 50,
    "rtsp_transport": "tcp",
    "plate": {
      "cj": {
        "enabled": false,
        "host": "",
        "port": 554,
        "username": "",
        "password": "",
        "stream_channel": 101
      },
      "rj2": {
        "enabled": false,
        "host": "",
        "port": 554,
        "username": "",
        "password": "",
        "stream_channel": 101
      },
      "rj3": {
        "enabled": false,
        "host": "",
        "port": 554,
        "username": "",
        "password": "",
        "stream_channel": 101
      }
    }
  },
  "log": {
    "dir": "HZCYKJTHardWareDLL_Logs",
    "level": "info",
    "retention_days": 30,
    "max_total_size_mb": 2048,
    "disk_warning_free_mb": 2048,
    "flush_interval_ms": 500,
    "flush_batch_size": 50
  }
}
