<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <RootNamespace>HZCYKJTHardWare.Proxy</RootNamespace>
    <AssemblyName>HZCYKJTHardWare.Proxy</AssemblyName>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x64'">x86</PlatformTarget>
    <Platforms>x86;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- 构建环境可能无法访问漏洞审计源，关闭还原阶段审计以避免 NU1900。 -->
    <NuGetAudit>false</NuGetAudit>
    <ApplicationIcon>国移局icon_256x256.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);_codex_build\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_codex_build\**\*.cs" />
    <EmbeddedResource Remove="_codex_build\**\*" />
    <None Remove="_codex_build\**\*" />
    <Content Remove="_codex_build\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="国移局icon_256x256.ico" />
    <Content Include="..\..\..\HZCYKJTHardWare.json" Link="HZCYKJTHardWare.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- VLC: keep x86/x64 source and output directories separate. -->
  <ItemGroup>
    <Content Include="vlc\**\*"
             Condition="'$(Platform)' != 'x64'"
             Exclude="vlc\plugins\access\libsftp_plugin.dll"
             CopyToOutputDirectory="PreserveNewest"
             LinkBase="vlc\" />
    <Content Include="vlc-x64\**\*"
             Condition="'$(Platform)' == 'x64'"
             Exclude="vlc-x64\plugins\access\libsftp_plugin.dll"
             CopyToOutputDirectory="PreserveNewest"
             Link="vlc-x64\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RemoveUnsupportedVlcPlugins" AfterTargets="Build">
    <Delete Files="$(TargetDir)vlc\plugins\access\libsftp_plugin.dll"
            Condition="'$(Platform)' != 'x64'"
            TreatErrorsAsWarnings="true" />
    <Delete Files="$(TargetDir)vlc-x64\plugins\access\libsftp_plugin.dll"
            Condition="'$(Platform)' == 'x64'"
            TreatErrorsAsWarnings="true" />
  </Target>

</Project>
